generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id           Int       @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String?   @unique
  dob          DateTime?
  studentClass String?
  roll         String?   @unique
  parentName   String?
  phone        String?
  status       String    @default("Active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
